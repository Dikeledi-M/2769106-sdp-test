# Copy this file to `.env` and adjust the values.

# --- Database ---
# SQLite is used for local development; the schema is written to be
# PostgreSQL compatible so switching is only a connection-string change.
DATABASE_URL=sqlite:///./rat.db
# PostgreSQL example (requires a running PostgreSQL server):
# DATABASE_URL=postgresql+psycopg://rat:rat@localhost:5432/rat

# --- Authentication ---
# Generate a strong random value in production, e.g. `openssl rand -hex 32`.
# Must be at least 32 bytes for HS256.
SECRET_KEY=change-me-generate-a-random-32-byte-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed frontend origins.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
