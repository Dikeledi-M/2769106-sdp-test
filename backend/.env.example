# Copy this file to `.env` (same directory) and adjust as needed.
# Every value below matches the built-in default, so the backend runs
# without a .env file at all during local development.

# --- Database ---
# SQLite file, relative to the backend/ working directory.
# PostgreSQL example: postgresql+psycopg://rat:rat@localhost:5432/rat
DATABASE_URL=sqlite:///./rat.db

# --- Authentication ---
# Must be at least 32 bytes for HS256. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (comma-separated list of allowed browser origins) ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Repository storage (relative to the backend/ working directory) ---
DATA_DIR=data
UPLOAD_DIR=data/uploads
CLONE_DIR=data/clones
